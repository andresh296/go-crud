{
  "schemas": [
    {
      "name": "UserRequest",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "El nombre del usuario",
          "required": true,
          "maxLength": 100
        },
        "age": {
          "type": "integer",
          "description": "La edad del usuario",
          "required": true,
          "minimum": 18
        },
        "email": {
          "type": "string",
          "description": "El correo electrónico del usuario",
          "required": true,
          "format": "email"
        },
        "password": {
          "type": "string",
          "description": "La contraseña del usuario",
          "required": true,
          "minLength": 8
        }
      }
    }
  ]
}